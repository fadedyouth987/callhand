# Copy to .env and fill in. Never commit real values.

# Public HTTPS address of this server. Twilio calls it and connects the call
# audio to wss://<this host>/twilio/relay. Live calls need https.
APP_URL=http://localhost:3000
PORT=3000

# Supabase project (Settings -> API).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Used for Twilio webhooks and the call socket, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The same Supabase values for the dashboard (baked in at build time).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Twilio account that owns the phone numbers. The default number is only used
# as the sender for owner alerts when a call's own number cannot be used.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OpenAI for the conversation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Signs the short-lived token that links a Twilio call to its socket.
# 32+ random characters, e.g. `openssl rand -hex 32`.
CALL_TOKEN_SECRET=
